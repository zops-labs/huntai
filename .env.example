# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
BASE_URL=https://huntai.railway.app

# ── Supabase (EU Frankfurt) ────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Google Places (optional — used during onboarding to auto-fill business
# profile from Google Maps. If unset, onboarding just skips auto-fill and
# asks the owner for everything manually.) ────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Retell AI ─────────────────────────────────────────────────────────────────
RETELL_API_KEY=key_...
RETELL_WEBHOOK_SECRET=<hmac-secret-from-retell-dashboard>

# ── Twilio (SMS + WhatsApp) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Your Twilio WhatsApp number (Sandbox: +14155238886, or your approved number)
# Must include country code, no "whatsapp:" prefix here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://huntai.railway.app/auth/google/callback

# ── Inngest ───────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-prod-...

# ── Encryption (AES-256, 32 bytes hex-encoded) ────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<64-char-hex-string>

# ── Resend (fallback email alerts) ────────────────────────────────────────────
RESEND_API_KEY=re_...
